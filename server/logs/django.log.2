                }
            }
            {
                "turn 1": {
                "Alice":  "Opinion: abortion should be legal; Arguments: Respects bodily autonomy.",
                "Bob":    "Opinion: abortion should not be legal; Arguments: Harms the unborn."
                },
                "turn 2": {
